{
  "name": "@zanreal/medusa-allegro",
  "version": "1.0.0",
  "description": "Medusa v2 plugin integrating Allegro, the Polish marketplace: OAuth connection, encrypted token storage, offer/SKU mapping and price-automation audit models.",
  "keywords": [
    "allegro",
    "marketplace",
    "medusa",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-v2",
    "plugin",
    "poland"
  ],
  "homepage": "https://zanreal.com/docs/oss/medusa-allegro",
  "bugs": {
    "url": "https://github.com/zanreal-labs/medusa-allegro/issues"
  },
  "license": "MIT",
  "author": "ZanReal Labs (https://zanreal.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/medusa-allegro.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    ".medusa/server",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@zanreal/medusa-admin-kit": "^0.2.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p src/admin/tsconfig.json",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "prepare": "medusa plugin:build",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/eslint-plugin": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "i18next": "23.7.11",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "13.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "yalc": "1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.21.1",
    "@medusajs/admin-shared": "2.21.1",
    "@medusajs/cli": "2.21.1",
    "@medusajs/framework": "2.21.1",
    "@medusajs/icons": "2.21.1",
    "@medusajs/js-sdk": "2.21.1",
    "@medusajs/medusa": "2.21.1",
    "@medusajs/test-utils": "2.21.1",
    "@medusajs/ui": "4.2.5"
  },
  "engines": {
    "node": ">=20"
  }
}
