{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "dependencyDashboard": false,
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 6am on Monday"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 0,
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": false,
  "automerge": false,
  "minimumReleaseAge": "1 day",
  "statusCheckWhen": {
    "minimumReleaseAge": "never",
    "artifactError": "never"
  },
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Everything (npm, GitHub Actions, pnpm itself, Medusa; patch, minor and major) goes into ONE weekly PR per repo, merged by hand. Lockfile refresh happens inside that PR, so separate lock file maintenance is off.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "automerge": false
    },
    {
      "description": "Medusa ships every @medusajs package in lockstep and the host app pins the same set. rangeStrategy bump rewrites the peer pin too, instead of widening it.",
      "matchPackageNames": [
        "@medusajs/**"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Mark the weekly PR when it contains a major update, so it gets a closer review.",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ],
    "prCreation": "immediate",
    "dependencyDashboardApproval": false
  }
}
